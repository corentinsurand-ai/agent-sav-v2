{
  "version": 2,
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/sync-clients",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/wa-config",
      "destination": "/api/whatsapp-messages?waConfig=1"
    },
    {
      "source": "/api/emails",
      "destination": "/api/mails"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    }
  ]
}
